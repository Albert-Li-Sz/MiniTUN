#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034,SC3043

START=95
STOP=10
USE_PROCD=1

PROG=/usr/libexec/minitun/minitund

prepare_directories() {
	mkdir -p /run/minitun /etc/minitun
	chown minitun:minitun /run/minitun /etc/minitun
	chmod 0750 /run/minitun /etc/minitun
}

start_service() {
	local enabled socket database credentials tls_ca insecure_skip_verify
	local io_threads log_level

	config_load minitun
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get socket main socket /run/minitun/minitun.sock
	config_get database main database /etc/minitun/state.db
	config_get credentials main credentials /etc/minitun/credentials.db
	config_get tls_ca main tls_ca
	config_get_bool insecure_skip_verify main insecure_skip_verify 0
	config_get io_threads main io_threads 1
	config_get log_level main log_level info

	prepare_directories

	procd_open_instance
	procd_set_param command "$PROG" --foreground
	procd_append_param command --socket "$socket"
	procd_append_param command --database "$database"
	procd_append_param command --credentials "$credentials"
	procd_append_param command --io-threads "$io_threads"
	procd_append_param command --log-level "$log_level"
	[ -n "$tls_ca" ] && procd_append_param command --tls-ca "$tls_ca"
	[ "$insecure_skip_verify" -eq 1 ] && \
		procd_append_param command --insecure-skip-verify
	procd_set_param user minitun
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="8192 8192"
	procd_set_param file /etc/config/minitun
	[ -n "$tls_ca" ] && procd_append_param file "$tls_ca"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 15
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger minitun
}
