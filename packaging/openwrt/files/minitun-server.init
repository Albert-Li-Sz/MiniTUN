#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034,SC3043

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/minitun-server

start_service() {
	local enabled listen tls_cert tls_key token_file allow_ports
	local io_threads log_level

	config_load minitun-server
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get listen main listen 0.0.0.0:2333
	config_get tls_cert main tls_cert /etc/minitun-server/server.crt
	config_get tls_key main tls_key /etc/minitun-server/server.key
	config_get token_file main token_file /etc/minitun-server/token
	config_get allow_ports main allow_ports
	config_get io_threads main io_threads 1
	config_get log_level main log_level info

	procd_open_instance
	procd_set_param command "$PROG" --foreground
	procd_append_param command --listen "$listen"
	procd_append_param command --tls-cert "$tls_cert"
	procd_append_param command --tls-key "$tls_key"
	procd_append_param command --token-file "$token_file"
	procd_append_param command --io-threads "$io_threads"
	procd_append_param command --log-level "$log_level"
	[ -n "$allow_ports" ] && \
		procd_append_param command --allow-ports "$allow_ports"
	procd_set_param user minitun-server
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="16384 16384"
	procd_set_param file /etc/config/minitun-server
	procd_append_param file "$tls_cert" "$tls_key" "$token_file"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 15
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger minitun-server
}
