#!/sbin/openrc-run
# MiniTun public server for OpenRC (Alpine, Gentoo).
name="minitun-server"
description="MiniTun public server"
command="/usr/bin/minitun-server"
command_args="--foreground --listen 0.0.0.0:2333 --tls-cert /etc/minitun-server/server.crt --tls-key /etc/minitun-server/server.key --clients-config /etc/minitun-server/clients.json"
command_user="minitun-server:minitun-server"
pidfile="/run/${RC_SVCNAME}.pid"
command_background=false

depend() {
    need net
    after firewall
}
